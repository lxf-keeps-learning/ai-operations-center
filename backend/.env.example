# 应用
APP_NAME=智能运营中心 AI Agent Runtime
APP_ENV=local                          # local | dev | test | prod
RAG_ALLOW_MOCK=false                   # 仅开发/自动化测试可显式开启
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 时区 & 日志
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR

# 数据库
DATABASE_URL=mysql+pymysql://AIOpertionsCenter:12345678@localhost:3306/ioc_ai
# LangGraph 官方 Checkpointer / Store（PostgreSQL）。生产环境建议配置；为空时仅用于本地开发。
LANGGRAPH_POSTGRES_URL=postgresql://langgraph:langgraph_password@localhost:5432/langgraph

# Redis（可选，Sprint1 可禁用）
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Tool Registry（MySQL-backed runtime discovery & governance）
TOOL_REGISTRY_MODE=legacy                    # legacy | database
TOOL_REGISTRY_CACHE_TTL_SECONDS=30
TOOL_REGISTRY_STALE_QUERY_TTL_SECONDS=86400
TOOL_DEFAULT_RATE_LIMIT_PER_MINUTE=60
TOOL_CONFIRMATION_TTL_SECONDS=300
# TOOL_CONFIRMATION_SECRET=

# 大模型 API Key（通过环境变量注入，不在代码中硬编码）
# QWEN_API_KEY=
# DEEPSEEK_API_KEY=
# DOUBAO_API_KEY=
# ZHIPU_API_KEY=

# LangSmith Agent 可观测性（密钥只放本地 .env 或密钥管理系统）
LANGSMITH_TRACING=false
# Prompt Hub 自动同步独立开关；开启后同步失败会阻止灰度/正式发布
LANGSMITH_PROMPT_SYNC_ENABLED=false
# LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=ioc-agent-local
LANGSMITH_SAMPLING_RATE=1.0
LANGSMITH_MASK_INPUTS_OUTPUTS=true

# Operation Agent 运营报告生成：单次 LLM 调用超时时间（秒）
OPERATION_LLM_TIMEOUT_SECONDS=60

# ── 超时与取消策略（绝对 Deadline + 全链路异步取消）────────────────────
# Query 工具单次执行默认超时（秒）
TOOL_QUERY_TIMEOUT_SECONDS=15
# 写操作（action）工具单次执行默认超时（秒）；超时后结果状态标记 result_unknown
TOOL_WRITE_TIMEOUT_SECONDS=30
# LLM 单次调用统一默认超时（秒），流式与非流式均受此约束
LLM_TIMEOUT_SECONDS=60
# 报告生成外部总预算（秒），含失败持久化、审计、SSE 终止事件与资源清理
REPORT_GENERATION_TIMEOUT_SECONDS=120
# 报告 Graph 执行预算（秒），须小于 REPORT_GENERATION_TIMEOUT_SECONDS
REPORT_GRAPH_TIMEOUT_SECONDS=115
# SSE 连续无业务事件或心跳的空闲超时（秒），触发后终止事件流
SSE_IDLE_TIMEOUT_SECONDS=30
# SSE 心跳发送间隔（秒），须小于 SSE_IDLE_TIMEOUT_SECONDS
SSE_HEARTBEAT_INTERVAL_SECONDS=15
# Graph 超时后预留的清理时间（秒），用于失败状态持久化与终止事件
TIMEOUT_CLEANUP_RESERVE_SECONDS=5
