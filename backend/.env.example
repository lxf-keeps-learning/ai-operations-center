# 应用
APP_NAME=智能运营中心 AI Agent Runtime
APP_ENV=local                          # local | dev | test | prod
RAG_ALLOW_MOCK=false                   # 仅开发/自动化测试可显式开启
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 时区 & 日志
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR

# 数据库
DATABASE_URL=mysql+pymysql://AIOpertionsCenter:12345678@localhost:3306/ioc_ai
# LangGraph 官方 Checkpointer / Store（PostgreSQL）。生产环境建议配置；为空时仅用于本地开发。
LANGGRAPH_POSTGRES_URL=postgresql://langgraph:langgraph_password@localhost:5432/langgraph

# Redis（可选，Sprint1 可禁用）
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# 大模型 API Key（通过环境变量注入，不在代码中硬编码）
# QWEN_API_KEY=
# DEEPSEEK_API_KEY=
# DOUBAO_API_KEY=

# LangSmith Agent 可观测性（密钥只放本地 .env 或密钥管理系统）
LANGSMITH_TRACING=false
# Prompt Hub 自动同步独立开关；开启后同步失败会阻止灰度/正式发布
LANGSMITH_PROMPT_SYNC_ENABLED=false
# LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=ioc-agent-local
LANGSMITH_SAMPLING_RATE=1.0
LANGSMITH_MASK_INPUTS_OUTPUTS=true

# Operation Agent 运营报告生成：单次 DeepSeek 调用超时时间（秒）
OPERATION_LLM_TIMEOUT_SECONDS=20
